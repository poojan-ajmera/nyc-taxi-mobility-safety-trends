    <worksheet name='Daily Taxi Trips with Trends '>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>2024 NYC Taxi Demand Patterns: Daily Trends, Holiday Dips &amp; Active Driver Benchmark</run>
          </formatted-text>
