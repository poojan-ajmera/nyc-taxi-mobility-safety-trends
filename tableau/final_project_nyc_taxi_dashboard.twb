            <column caption='Parameter 1' datatype='real' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='178834.'>
              <calculation class='tableau' formula='178834.' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1y8kir81loouwq13z2nwo1ro8hah'>
            <column caption='7 day moving average' datatype='real' name='[Calculation_671317886551502848]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(SUM([trip_count]), -6, 0)'>
